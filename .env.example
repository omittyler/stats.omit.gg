# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings -> Data API / API Keys in the Supabase dashboard).
# Never commit .env.local.

# Used only by the seed script (scripts/seed/) - full admin access, bypasses RLS.
# Never expose this one to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Used by the Next.js app itself. The NEXT_PUBLIC_ prefix means these ARE exposed
# to the browser - safe only because the anon key is gated by the RLS policies
# in supabase/rls_policies.sql (public read-only). Same URL as above.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
